# =====================================================
# JobFlow AI — Environment Configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env".
# =====================================================

# ---- Ollama (local LLM) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# ---- Embeddings (local, CPU) ----
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Database ----
DATABASE_PATH=./data/app.db

# ---- Matching thresholds ----
MATCH_THRESHOLD_HIGH=85
MATCH_THRESHOLD_MEDIUM=70

# ---- Resource limits (8 GB laptop friendly) ----
MAX_JOBS_PER_RUN=10

# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO